<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JS Object Manipulation</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f7f9fa;
            margin: 40px auto;
            max-width: 600px;
            color: #333;
        }
        .card {
            background: #ffffff;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
            border: 1px solid #e1e8ed;
        }
        h2 {
            color: #1da1f2;
            margin-top: 0;
            border-bottom: 2px solid #f1f3f5;
            padding-bottom: 10px;
        }
        h3 {
            color: #495057;
            margin-top: 20px;
        }
        .output-box {
            background-color: #f8f9fa;
            padding: 15px;
            border-left: 4px solid #1da1f2;
            border-radius: 4px;
            font-family: 'Courier New', Courier, monospace;
            white-space: pre-wrap;
        }
    </style>
</head>
<body>

    <div class="card">
        <h2>JavaScript Object Task</h2>
        
        <h3>1. All Original Properties:</h3>
        <div id="properties-list" class="output-box"></div>

        <h3>2. Object After Deleting 'age':</h3>
        <div id="object-display" class="output-box"></div>
    </div>

    <script>
        // 1. Define the sample object
        var Person = {
            firstName : "Tony",
            lastName : "Lee",
            age : 50,
            eyeColor : "Blue"
        };

        // 2. List all properties before deletion
        // Object.keys() extracts an array of the object's property names
        var allProperties = Object.keys(Person).join(", ");
        document.getElementById("properties-list").textContent = allProperties;

        // 3. Delete the age property from the object
        delete Person.age;

        // 4. Print the object after deleting the property
        // JSON.stringify formats the object cleanly for the web page display
        document.getElementById("object-display").textContent = JSON.stringify(Person, null, 4);
    </script>

</body>
</html>
